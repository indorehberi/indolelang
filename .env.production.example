# ============================================================
# FILE INI ADALAH TEMPLATE. SALIN KE .env DAN SESUAIKAN ISINYA
# Di server production: cp .env.production.example .env
# ============================================================

# ------ Database ------
DB_USER=postgres
DB_PASSWORD=GANTI_PASSWORD_DB_ANDA
DB_NAME=indolelang_prod

# ------ JWT ------
JWT_SECRET=GANTI_DENGAN_RANDOM_STRING_PANJANG
JWT_REFRESH_SECRET=GANTI_DENGAN_RANDOM_STRING_LAIN

# ------ Google OAuth ------
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# ------ AWS S3 ------
AWS_ACCESS_KEY_ID=GANTI_INI
AWS_SECRET_ACCESS_KEY=GANTI_INI
AWS_REGION=ap-southeast-3
AWS_S3_BUCKET=bidku-assets-prod

# ------ Midtrans ------
MIDTRANS_SERVER_KEY=GANTI_INI
MIDTRANS_CLIENT_KEY=GANTI_INI
MIDTRANS_IS_PRODUCTION=true
MIDTRANS_NOTIFICATION_URL=https://bidku.co.id/api/v1/payments/notification

# ------ Xendit ------
XENDIT_API_KEY=GANTI_INI

# ------ Verihubs (eKYC) ------
VERIHUBS_API_KEY=GANTI_INI
VERIHUBS_APP_ID=GANTI_INI

# ------ SMTP (EMAIL) ------
# !! WAJIB DIISI AGAR EMAIL RESET PASSWORD, NOTIFIKASI, DLL BERFUNGSI !!
#
# Pilihan 1: Gmail SMTP (App Password)
#   - Buka: https://myaccount.google.com/apppasswords
#   - Buat App Password untuk "Mail"
#   - Gunakan setting berikut:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM="Indo Lelang" <noreply@bidku.co.id>
#
# Pilihan 2: Mailgun
#   SMTP_HOST=smtp.mailgun.org
#   SMTP_PORT=587
#   SMTP_USER=postmaster@mg.bidku.co.id
#   SMTP_PASS=MAILGUN_SMTP_PASSWORD
#   SMTP_FROM="Indo Lelang" <noreply@bidku.co.id>
#
# Pilihan 3: AWS SES
#   SMTP_HOST=email-smtp.ap-southeast-1.amazonaws.com
#   SMTP_PORT=587
#   SMTP_USER=SES_ACCESS_KEY
#   SMTP_PASS=SES_SECRET
#   SMTP_FROM="Indo Lelang" <noreply@bidku.co.id>

# ------ Public URLs ------
PUBLIC_API_URL=https://bidku.co.id
PUBLIC_ADMIN_URL=https://bidku.co.id/admin
