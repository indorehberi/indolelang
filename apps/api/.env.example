# Server Configuration
PORT=8000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL)
# Docker local dev: postgresql://indolelang:indolelang@localhost:5432/indolelang_dev
DATABASE_URL="postgresql://indolelang:indolelang@localhost:5432/indolelang_dev"

# Redis Configuration (Cache & Rate Limiting)
REDIS_URL="redis://localhost:6379"

# Security (JWT)
# Generate secrets using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-access-token-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-jwt-refresh-token-key-change-in-production"

# SMTP (Email Testing using Mailhog)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@indo-lelang.com"

# AWS S3 (Storage)
AWS_ACCESS_KEY_ID="dummy_key"
AWS_SECRET_ACCESS_KEY="dummy_secret"
AWS_REGION="ap-southeast-3"
AWS_S3_BUCKET="indo-lelang-assets-dev"

# Third-party Integrations
VERIHUBS_API_KEY="dummy_verihubs_key"
VERIHUBS_APP_ID="dummy_verihubs_app_id"

MIDTRANS_SERVER_KEY="dummy_midtrans_server_key"
MIDTRANS_CLIENT_KEY="dummy_midtrans_client_key"
MIDTRANS_IS_PRODUCTION=false
# Optional: Override notification webhook URL if sharing sandbox account across projects
# MIDTRANS_NOTIFICATION_URL="https://[your-ngrok-id].ngrok-free.app/api/v1/payments/notification"


# Xendit (Disbursement)
XENDIT_API_KEY="dummy-xendit-api-key"

