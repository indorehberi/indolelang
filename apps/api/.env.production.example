# Server Configuration
PORT=8000
NODE_ENV=production
API_PREFIX=/api/v1
CORS_ORIGIN=https://bidku.co.id

# Database Configuration (PostgreSQL)
# Managed DB or Docker: Since Docker is used locally/in VPS, this should match docker-compose.prod.yml
DATABASE_URL="postgresql://indolelang:CHANGE_THIS_PASSWORD@postgres:5432/indolelang_prod?schema=public"

# Redis Configuration (Cache & Rate Limiting)
REDIS_URL="redis://redis:6379"

# Security (JWT)
# Generate secrets using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="CHANGE_THIS_SUPER_SECRET_JWT_KEY_PRODUCTION"
JWT_REFRESH_SECRET="CHANGE_THIS_SUPER_SECRET_JWT_REFRESH_KEY_PRODUCTION"

# SMTP (Production Email)
SMTP_HOST="smtp.mailgun.org" # Or AWS SES / SendGrid
SMTP_PORT=587
SMTP_USER="CHANGE_ME"
SMTP_PASS="CHANGE_ME"
SMTP_FROM="noreply@bidku.co.id"

# AWS S3 (Storage)
AWS_ACCESS_KEY_ID="CHANGE_ME"
AWS_SECRET_ACCESS_KEY="CHANGE_ME"
AWS_REGION="ap-southeast-3"
AWS_S3_BUCKET="bidku-assets-prod"

# Third-party Integrations
VERIHUBS_API_KEY="CHANGE_ME"
VERIHUBS_APP_ID="CHANGE_ME"

MIDTRANS_SERVER_KEY="CHANGE_ME"
MIDTRANS_CLIENT_KEY="CHANGE_ME"
MIDTRANS_IS_PRODUCTION=true
MIDTRANS_NOTIFICATION_URL="https://bidku.co.id/api/v1/payments/notification"

# Xendit (Disbursement)
XENDIT_API_KEY="CHANGE_ME"
