{
  "name": "indo-lelang",
  "version": "0.1.0",
  "private": true,
  "description": "Platform Lelang Digital Indo-Lelang — Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npx -y concurrently \"npm run dev:api\" \"npm run dev:admin\" \"npm run dev:web\"",
    "dev:frontend": "npx -y concurrently \"npm run dev:admin\" \"npm run dev:web\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:admin": "npm run dev -w apps/admin-panel",
    "dev:web": "npm run dev -w apps/landing-web",
    "build:api": "npm run build -w apps/api",
    "build:admin": "npm run build -w apps/admin-panel",
    "build:web": "npm run build -w apps/landing-web",
    "test": "npm run test --workspaces --if-present",
    "test:api": "npm run test -w apps/api",
    "test:e2e": "playwright test",
    "test:load": "k6 run tests/load/catalog-load-test.js",
    "test:smoke": "node scripts/smoke-test.js",
    "test:all": "npm run test:api && npm run test:e2e && npm run test:smoke",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "db:reset": "npm run db:reset -w apps/api",
    "docker:up": "docker-compose -f infrastructure/docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f infrastructure/docker/docker-compose.yml down",
    "docker:logs": "docker-compose -f infrastructure/docker/docker-compose.yml logs -f"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Indo-Lelang Team",
  "license": "UNLICENSED",
  "devDependencies": {
    "@playwright/test": "^1.61.1"
  }
}
